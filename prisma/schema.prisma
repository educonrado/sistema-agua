// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Configuracion {
  id                    Int     @id @default(autoincrement())
  nombreJunta           String  @unique
  costoAguaCruda        Float   // Costo del agua cruda (base)
  limiteConsumoBasico   Float   // Límite de consumo básico en m³
  costoTarifaBase       Float   // Costo de la tarifa base
  costoM3Excedente      Float   // Costo por m³ excedente
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Usuario {
  id                    Int     @id @default(autoincrement())
  nombre                String  @unique
  email                 String? @unique
  passwordHash          String
  rol                   String  @default("DIGITADOR") // ADMINISTRADOR, DIGITADOR
  activo                Boolean @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
