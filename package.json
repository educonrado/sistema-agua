{
  "name": "sistema-agua",
  "version": "1.0.0",
  "description": "Sistema de gestión de agua potable para comunidades rurales",
  "main": "dist/main/main.js",
  "homepage": "./",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/educonrado/sistema-agua.git"
  },
  "keywords": [],
  "author": "",
