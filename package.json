  "type": "module",
  "bugs": {
    "url": "https://github.com/educonrado/sistema-agua/issues"
  },
  "homepage": "https://github.com/educonrado/sistema-agua#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.0",
    "electron": "^44.0.0",
    "jsdom": "^23.0.0",
    "prisma": "^5.9.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^1.0.4",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.6"
  }
